[Unit]
Description=AnySale Lead Service
After=network.target

[Service]
Type=simple
User=anysale
WorkingDirectory=/opt/anysale/lead-service
EnvironmentFile=/opt/anysale/env/lead-service.env
ExecStart=/usr/bin/java -jar /opt/anysale/lead-service/anysale-lead-service-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
