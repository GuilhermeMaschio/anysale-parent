# Single-host staging preset
# Assumes PostgreSQL is reachable from the JVM through the same host.

SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5435/anysale
SPRING_DATASOURCE_USERNAME=anysale
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_FLYWAY_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=lead-service
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
