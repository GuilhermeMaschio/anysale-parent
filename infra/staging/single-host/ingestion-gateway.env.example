# Single-host staging preset
# Assumes lead-service listens on the same host.

SERVER_PORT=8083
LEAD_SERVICE_BASE_URL=http://127.0.0.1:8080
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
LEAD_CLIENT_RETRY_MAX_ATTEMPTS=3
LEAD_CLIENT_RETRY_WAIT_DURATION=300ms
LEAD_CLIENT_CB_SLIDING_WINDOW_SIZE=10
LEAD_CLIENT_CB_FAILURE_RATE_THRESHOLD=50
