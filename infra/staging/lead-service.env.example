SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-staging:5432/anysale
SPRING_DATASOURCE_USERNAME=anysale
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_FLYWAY_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-staging:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=lead-service
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
ANYSALE_INTERNAL_TOKEN=change-me-to-a-long-random-shared-secret
NOTIFICATION_SERVICE_BASE_URL=https://notification-service-staging.anysale.internal
ANYSALE_SECURITY_ENABLED=true
KEYCLOAK_ISSUER=https://keycloak-staging.example/realms/anysale-realm
ANYSALE_SECURITY_KEYCLOAK_CLIENT_ID=anysale-console
ANYSALE_KEYCLOAK_ADMIN_ENABLED=false
ANYSALE_KEYCLOAK_ADMIN_CLIENT_ID=
ANYSALE_KEYCLOAK_ADMIN_CLIENT_SECRET=
ANYSALE_BILLING_ASAAS_ENABLED=false
# Never commit these values. Generate a dedicated webhook token distinct from the Asaas API key.
ANYSALE_BILLING_ASAAS_API_KEY=
ANYSALE_BILLING_ASAAS_WEBHOOK_TOKEN=
ANYSALE_AI_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ALLOWED_MODELS=
