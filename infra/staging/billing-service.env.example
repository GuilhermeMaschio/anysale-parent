SERVER_PORT=8083
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-staging:5432/anysale
SPRING_DATASOURCE_USERNAME=anysale
SPRING_DATASOURCE_PASSWORD=change-me
ANYSALE_SECURITY_ENABLED=true
ANYSALE_SECURITY_KEYCLOAK_CLIENT_ID=anysale-console
ANYSALE_BILLING_ASAAS_ENABLED=false
# Keep both values only in the deployment secret store, never in the repository or Console.
ANYSALE_BILLING_ASAAS_API_KEY=
ANYSALE_BILLING_ASAAS_WEBHOOK_TOKEN=
ANYSALE_BILLING_ASAAS_BASE_URL=https://api.asaas.com/v3
ANYSALE_BILLING_CHECKOUT_SUCCESS_URL=https://console.example.com/billing/success
ANYSALE_BILLING_CHECKOUT_CANCEL_URL=https://console.example.com/billing/cancelled
ANYSALE_BILLING_CHECKOUT_EXPIRED_URL=https://console.example.com/billing/expired
