  "item": [
    {
      "name": "1. Catalog Integrations",
      "item": [
        {
          "name": "1.1. Criar Integração",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response has integration ID and hasCredentials flag', function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.hasCredentials).to.eql(true);",
                  "    pm.expect(jsonData.encryptedCredentials).to.be.undefined;",
                  "    pm.expect(jsonData.secret).to.be.undefined;",
                  "});",
                  "",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('integrationId', jsonData.id);",
                  "    console.log('Saved integrationId: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ERP DummyJSON Teste\",\n  \"providerType\": \"GENERIC_REST\",\n  \"baseUrl\": \"https://dummyjson.com/products\",\n  \"status\": \"ACTIVE\",\n  \"authType\": \"NONE\",\n  \"secret\": \"opcional_secret_token_123\",\n  \"apiKeyHeaderName\": \"X-API-Key\",\n  \"apiKeyQueryName\": \"api_key\",\n  \"syncMode\": \"MANUAL\",\n  \"conflictStrategy\": \"EXTERNAL_WINS\",\n  \"skuFallbackEnabled\": true,\n  \"fieldMapping\": {\n    \"sku\": \"sku\",\n    \"title\": \"title\",\n    \"price\": \"price\",\n    \"stockQuantity\": \"stock\",\n    \"category\": \"category\",\n    \"description\": \"description\",\n    \"imageUrl\": \"thumbnail\"\n  }\n}"
            },
            "url": {
              "raw": "{{catalogServiceUrl}}/v1/catalog-integrations",
              "host": [
                "{{catalogServiceUrl}}"
              ],
              "path": [
                "v1",
                "catalog-integrations"
              ]
            },
            "description": "Cria uma nova integração de catálogo externa."
          },
          "response": []
        },
        {
          "name": "1.2. Listar Integrações",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response is an array without secrets', function () {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0].encryptedCredentials).to.be.undefined;",
                  "        pm.expect(jsonData[0].secret).to.be.undefined;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{catalogServiceUrl}}/v1/catalog-integrations",
              "host": [
                "{{catalogServiceUrl}}"
              ],
              "path": [
                "v1",
                "catalog-integrations"
              ]
            },
            "description": "Lista todas as integrações cadastradas para o tenant."
          },
          "response": []
